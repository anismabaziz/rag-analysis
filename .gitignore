# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# secrets
.env
.env.*
!.env.example

# The corpus is a committed manifest, not committed documents. The PDFs under ./documents are
# fetched and checked against their digest, and are far too large to keep in the repository.
documents/**/*.pdf

# results are committed, so nothing else is ignored by extension here

# pytest and ruff caches
.pytest_cache/
.ruff_cache/
