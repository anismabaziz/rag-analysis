# Copy to .env and fill in. .env is ignored by git, so nothing here is committed.

# Required. Generation is frozen to one model and temperature 0 across every run,
# so a run that has to guess a key is not comparable to a published one.
GROQ_API_KEY=

# The one generation model every architecture answers with. Change it only to re-run
# the whole comparison: a results table with two models in it compares two setups,
# not two retrieval architectures.
GENERATION_MODEL=llama-3.3-70b-versatile

# Where the dense and sparse vectors are indexed. The default is the Qdrant that
# docker-compose.yaml starts, so this only needs changing if yours runs elsewhere.
QDRANT_URL=http://localhost:6333

# Only read by the graph modules, which are not part of the retrieval comparison.
# The defaults are what docker-compose.yaml starts Neo4j with.
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
